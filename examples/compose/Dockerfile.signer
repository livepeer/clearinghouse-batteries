# Build from the livepeer/node checkout selected by NODE_SOURCE.
FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /livepeer-signer ./cmd/livepeer-signer

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /livepeer-signer /usr/local/bin/livepeer-signer
ENTRYPOINT ["livepeer-signer"]
