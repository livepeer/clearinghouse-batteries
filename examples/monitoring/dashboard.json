{
  "title": "Clearinghouse operations",
  "uid": "clearinghouse-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "clearinghouse",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(livepeer_clearinghouse_component_enabled, clearinghouse)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Components",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_component_ready{clearinghouse=~\"$clearinghouse\"} and on (instance, component,clearinghouse) livepeer_clearinghouse_component_enabled{clearinghouse=~\"$clearinghouse\"} == 1",
          "legendFormat": "{{instance}} {{component}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Collection health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_collector_success{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{collector}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Collection age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - livepeer_clearinghouse_collector_last_success_timestamp_seconds{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{collector}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Authorization",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Decisions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision,reason) (rate(livepeer_clearinghouse_authorization_decisions_total{clearinghouse=~\"$clearinghouse\"}[5m]))",
          "legendFormat": "{{decision}} {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (listener,code) (rate(livepeer_clearinghouse_http_requests_total{clearinghouse=~\"$clearinghouse\",route!~\"GET /(?:livez|readyz)\"}[5m]))",
          "legendFormat": "{{listener}} {{code}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Accounting delivery",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Total backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(livepeer_clearinghouse_accounting_lag_records{clearinghouse=~\"$clearinghouse\"})",
          "legendFormat": "Total backlog"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Worst partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(livepeer_clearinghouse_accounting_lag_records{clearinghouse=~\"$clearinghouse\"})",
          "legendFormat": "Worst partition"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(livepeer_clearinghouse_usage_events_total{clearinghouse=~\"$clearinghouse\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Apply delay p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by (le) (rate(livepeer_clearinghouse_accounting_apply_delay_seconds_bucket{clearinghouse=~\"$clearinghouse\"}[5m])))",
          "legendFormat": "Apply delay p99"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Signer pending events",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_signer_kafka_pending_events{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Signer oldest event age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_signer_kafka_oldest_event_age_seconds{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Signer outbox health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_signer_kafka_outbox_healthy{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Signer publish errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(livepeer_signer_kafka_publish_errors_total{clearinghouse=~\"$clearinghouse\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Budget exposure",
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "eth overdraw",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_allocation_overdraw_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "usd overdraw",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_allocation_overdraw_usd{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Overdrawn allocations",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_allocations_overdrawn{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{currency}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Persistent quarantine",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_quarantined_events{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{reason}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "Chain progress",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Confirmed backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_chain_lag_blocks{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Head age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 77,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - livepeer_clearinghouse_chain_head_timestamp_seconds{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "RPC errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 85,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(livepeer_clearinghouse_chain_rpc_requests_total{clearinghouse=~\"$clearinghouse\",outcome=\"error\"}[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Reorgs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 85,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(livepeer_clearinghouse_chain_reorgs_total{clearinghouse=~\"$clearinghouse\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "row",
      "title": "Settlement and liquidity",
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Settlement matching",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 94,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_settlements{clearinghouse=~\"$clearinghouse\",status=\"settled\"}",
          "legendFormat": "{{instance}} {{match_status}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Face value",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 94,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_settlement_face_value_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Actual paid",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 102,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_settlement_paid_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Shortfall",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 102,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_settlement_shortfall_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Escrow totals",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 110,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_escrow_balance_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{bucket}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Minimum signer funds",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 110,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_escrow_min_balance_eth{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{bucket}}"
        }
      ]
    },
    {
      "id": 34,
      "type": "row",
      "title": "Storage",
      "gridPos": {
        "x": 0,
        "y": 118,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Database and WAL bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 119,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "livepeer_clearinghouse_storage_file_bytes{clearinghouse=~\"$clearinghouse\"}",
          "legendFormat": "{{instance}} {{role}} {{kind}}"
        }
      ]
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "Pool waits",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 119,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(livepeer_clearinghouse_db_pool_waits_total{clearinghouse=~\"$clearinghouse\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 37,
      "type": "timeseries",
      "title": "Service errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 127,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component,reason) (rate(livepeer_clearinghouse_service_errors_total{clearinghouse=~\"$clearinghouse\"}[5m]))",
          "legendFormat": "{{component}} {{reason}}"
        }
      ]
    }
  ]
}
